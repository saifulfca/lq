//@version=6
// LQ Playbook: marks the liquidity method from PLAYBOOK.md
// WHERE  : previous day/week high-low, Monday high-low, Monday shading, direction filter
// WHEN   : 1H / 4H fair value gaps and BPRs (non-repainting), removed once filled
// NOW    : swing + equal high/low liquidity, sweeps, possible inducement,
//          RSI divergence at sweeps, 3-candle displacement, setup + retrace entry,
//          suggested SL (beyond the order block) and TP (next opposing 1H/4H gap)
// Built for 5m-15m charts. Educational tool. Not financial advice.
indicator("LQ Playbook: Liquidity, Inducement, FVG", shorttitle = "LQPlaybook", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ───────────────────────────── Inputs ─────────────────────────────
const string GS = "Show / hide on chart"
showPW     = input.bool(true, "Weekly high / low (PWH / PWL)", group = GS, display = display.none)
showPD     = input.bool(true, "Daily high / low (PDH / PDL)", group = GS, display = display.none)
showMon    = input.bool(true, "Monday high / low", group = GS, display = display.none)
showMonBg  = input.bool(true, "Grey shading on Monday", group = GS, display = display.none)
showFvgA   = input.bool(true, "1H FVG zones (timeframe A)", group = GS, display = display.none)
showFvgB   = input.bool(true, "4H FVG zones (timeframe B)", group = GS, display = display.none)
showBprZ   = input.bool(true, "BPR zones", group = GS, display = display.none)
showEq     = input.bool(true, "Equal highs / lows (EQH / EQL)", group = GS, display = display.none)
showSwingL = input.bool(false, "All swing high / low lines", group = GS, display = display.none)
showSweeps = input.bool(true, "Liquidity sweeps / traps (triangles)", group = GS, display = display.none)
sweepScope = input.string("Key pools + inside zones", "Which sweeps", options = ["Key pools only", "Key pools + inside zones", "All"], tooltip = "Key pools = day / week / Monday highs and lows and equal highs / lows.", group = GS, display = display.none)
showDivCol = input.bool(true, "Yellow triangle when RSI diverges", group = GS, display = display.none)
showIdm    = input.bool(true, "Possible inducement (pink diamonds)", group = GS, display = display.none)
showBos    = input.bool(false, "BOS labels", group = GS, display = display.none)
showSetups = input.bool(true, "Setup labels + entry box", group = GS, display = display.none)
showTrades = input.bool(true, "BUY / SELL signals + SL / TP boxes", group = GS, display = display.none)

const string GK = "Chart scale"
keepScale = input.bool(true, "Keep normal chart scale (don't draw far-away levels / zones)", tooltip = "TradingView zooms out to fit everything an indicator draws. With this on, levels and zones farther than the distance below are not drawn. They are still used by the logic and listed in the status panel.", group = GK, display = display.none)
farMult   = input.float(1.5, "Max distance from price (x daily ATR)", minval = 0.2, step = 0.1, group = GK, display = display.none)

const string G0 = "Display"
lookback  = input.int(200, "Draw markers/lines for the last N bars", minval = 50, maxval = 5000, group = G0, display = display.none)
nearN     = input.int(2, "Show the nearest N zones above and below price", minval = 1, maxval = 20, group = G0, display = display.none)
textSizeI = input.string("Normal", "Text size", options = ["Small", "Normal", "Large"], group = G0, display = display.none)
idmGap    = input.int(30, "Min bars between inducement markers", minval = 1, group = G0, display = display.none)
idmAtr    = input.float(6, "Inducement only within x ATR of the zone", minval = 0.5, step = 0.5, group = G0, display = display.none)
tablePosI = input.string("Top right", "Status panel position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = G0, display = display.none)
showTable = input.bool(true, "Show status panel", group = G0, display = display.none)
showLegend = input.bool(true, "Show legend (what the symbols mean)", group = G0, display = display.none)

const string G1 = "WHERE: higher-timeframe levels"
biasMode = input.string("Both directions", "Allowed direction (set from your Where analysis)", options = ["Both directions", "Bearish only", "Bullish only", "Auto (daily close beyond prior day)"], group = G1, display = display.none)

const string G2 = "WHEN: 1H / 4H fair value gaps"
tfA      = input.timeframe("60", "FVG timeframe A", group = G2, display = display.none)
tfB      = input.timeframe("240", "FVG timeframe B", group = G2, display = display.none)
useB     = input.bool(true, "Use timeframe B", group = G2, display = display.none)
showBpr  = input.bool(true, "Detect BPR (overlap of opposite FVGs)", group = G2, display = display.none)
maxZones = input.int(30, "Max tracked zones", minval = 4, maxval = 150, group = G2, display = display.none)
fillMode = input.string("Wick", "Remove zone when price passes through it by", options = ["Wick", "Close"], group = G2, display = display.none)

const string G3 = "Liquidity (chart timeframe)"
pivLen    = input.int(5, "Swing length (bars each side)", minval = 2, group = G3, display = display.none)
eqTol     = input.float(0.15, "Equal high / low tolerance (x ATR)", minval = 0.01, step = 0.05, group = G3, display = display.none)
maxLevels = input.int(15, "Max tracked swings per side", minval = 3, maxval = 60, group = G3, display = display.none)

const string G4 = "NOW: confirmation and setups"
rsiLen   = input.int(14, "RSI length", minval = 2, group = G4, display = display.none)
dispMult = input.float(1.2, "Displacement: middle candle body >= x ATR", minval = 0.1, step = 0.1, group = G4, display = display.none)
window   = input.int(12, "Max bars from sweep to displacement", minval = 2, group = G4, display = display.none)
reqZone  = input.bool(true, "Require a 1H/4H zone tap", group = G4, display = display.none)
reqDiv   = input.bool(false, "Require RSI divergence", group = G4, display = display.none)
skipMon  = input.bool(true, "No setups on Monday", group = G4, display = display.none)
entryExp = input.int(20, "Bars to wait for the retrace entry", minval = 1, group = G4, display = display.none)
slBuf    = input.float(0.1, "Stop buffer beyond order block (x ATR)", minval = 0, step = 0.05, group = G4, display = display.none)

const string G5 = "Colours"
cBull = input.color(color.new(color.teal, 82), "Bullish FVG", group = G5, display = display.none)
cBear = input.color(color.new(color.red, 82), "Bearish FVG", group = G5, display = display.none)
cBpr  = input.color(color.new(color.purple, 72), "BPR", group = G5, display = display.none)
cBsl  = input.color(color.orange, "Buy-side liquidity (above highs)", group = G5, display = display.none)
cSsl  = input.color(color.aqua, "Sell-side liquidity (below lows)", group = G5, display = display.none)
cMon  = input.color(color.yellow, "Monday levels", group = G5, display = display.none)
cIdm  = input.color(color.fuchsia, "Possible inducement", group = G5, display = display.none)

// ───────────────────────────── Common ─────────────────────────────
sz       = textSizeI == "Small" ? size.small : textSizeI == "Large" ? size.large : size.normal
szSmall  = textSizeI == "Small" ? size.tiny : textSizeI == "Large" ? size.normal : size.small
draw     = bar_index >= last_bar_index - lookback
chartSec = timeframe.in_seconds(timeframe.period)
noColor  = color.new(color.black, 100)

atr = ta.atr(14)
rsi = ta.rsi(close, rsiLen)

tradingDay = time_tradingday
newDay     = ta.change(tradingDay) != 0
newWeek    = ta.change(time("W")) != 0
isMonday   = dayofweek(tradingDay, "UTC") == dayofweek.monday
monBlock   = skipMon and isMonday

// ───────────────────────────── WHERE ─────────────────────────────
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

f_bias() =>
    var int b = 0
    if close > high[1]
        b := 1
    else if close < low[1]
        b := -1
    b[1]

dAtr = request.security(syminfo.tickerid, "D", ta.atr(14)[1], lookahead = barmerge.lookahead_on)
f_near(float y) =>
    not keepScale or na(dAtr) or na(y) or math.abs(y - close) <= farMult * dAtr

dBias = nz(request.security(syminfo.tickerid, "D", f_bias(), lookahead = barmerge.lookahead_on))
isAuto     = biasMode == "Auto (daily close beyond prior day)"
allowShort = biasMode == "Both directions" or biasMode == "Bearish only" or (isAuto and dBias == -1)
allowLong  = biasMode == "Both directions" or biasMode == "Bullish only" or (isAuto and dBias == 1)

var float monHi = na
var float monLo = na
var bool  monHiT = false
var bool  monLoT = false
var int   monBar = na
if isMonday
    if newDay or na(monHi)
        monHi  := high
        monLo  := low
        monHiT := false
        monLoT := false
        monBar := bar_index
    else
        monHi := math.max(monHi, high)
        monLo := math.min(monLo, low)

var int dayBar  = 0
var int weekBar = 0
if newDay
    dayBar := bar_index
if newWeek
    weekBar := bar_index

bgcolor(showMonBg and isMonday and chartSec < 86400 ? color.new(color.gray, 93) : na, title = "Monday (no-trade day)")

// Event flags for this bar
bool bslTaken = false
bool sslTaken = false
bool bslEq    = false
bool sslEq    = false
bool bslSwing = false
bool sslSwing = false
bool bearDiv  = false
bool bullDiv  = false
bool bosUp    = false
bool bosDn    = false
string bslHtf = ""
string sslHtf = ""

// Higher-timeframe pools taken (first touch per day / week)
var bool pdhT = false
var bool pdlT = false
var bool pwhT = false
var bool pwlT = false
if newDay
    pdhT := false
    pdlT := false
if newWeek
    pwhT := false
    pwlT := false
if not pdhT and not na(pdh) and high > pdh
    pdhT := true
    bslTaken := true
    bslHtf += "PDH "
if not pdlT and not na(pdl) and low < pdl
    pdlT := true
    sslTaken := true
    sslHtf += "PDL "
if not pwhT and not na(pwh) and high > pwh
    pwhT := true
    bslTaken := true
    bslHtf += "PWH "
if not pwlT and not na(pwl) and low < pwl
    pwlT := true
    sslTaken := true
    sslHtf += "PWL "
if not isMonday and not monHiT and not na(monHi) and high > monHi
    monHiT := true
    bslTaken := true
    bslHtf += "MonH "
if not isMonday and not monLoT and not na(monLo) and low < monLo
    monLoT := true
    sslTaken := true
    sslHtf += "MonL "

// Current-period levels drawn once, at the right edge, with a name tag
type Mark
    line  ln
    label lb

f_level(Mark m, int x1, float y, string name, bool taken, color c, int w, bool show) =>
    near = f_near(y)
    if show and not na(y) and near
        txt = name + " " + str.tostring(y, format.mintick) + (taken ? " (taken)" : "")
        st  = taken ? line.style_dashed : line.style_solid
        if na(m.ln)
            m.ln := line.new(x1, y, bar_index + 5, y, color = c, width = w, style = st)
            m.lb := label.new(bar_index + 5, y, txt, style = label.style_label_left, color = noColor, textcolor = c, size = szSmall)
        else
            m.ln.set_xy1(x1, y)
            m.ln.set_xy2(bar_index + 5, y)
            m.ln.set_style(st)
            m.lb.set_xy(bar_index + 5, y)
            m.lb.set_text(txt)
    else if not na(m.ln)
        m.ln.delete()
        m.lb.delete()
        m.ln := na
        m.lb := na
    show and not na(y) and not near

var Mark mPdh = Mark.new()
var Mark mPdl = Mark.new()
var Mark mPwh = Mark.new()
var Mark mPwl = Mark.new()
var Mark mMh  = Mark.new()
var Mark mMl  = Mark.new()

string farTxt = ""
if barstate.islast
    intra = chartSec < 86400
    if f_level(mPwh, weekBar, pwh, "PWH", pwhT, cBsl, 2, showPW and chartSec < 604800)
        farTxt += "PWH " + str.tostring(pwh, format.mintick) + "  "
    if f_level(mPwl, weekBar, pwl, "PWL", pwlT, cSsl, 2, showPW and chartSec < 604800)
        farTxt += "PWL " + str.tostring(pwl, format.mintick) + "  "
    if f_level(mPdh, dayBar, pdh, "PDH", pdhT, cBsl, 1, showPD and intra)
        farTxt += "PDH " + str.tostring(pdh, format.mintick) + "  "
    if f_level(mPdl, dayBar, pdl, "PDL", pdlT, cSsl, 1, showPD and intra)
        farTxt += "PDL " + str.tostring(pdl, format.mintick) + "  "
    monShow = showMon and intra and not isMonday and not na(monBar)
    if f_level(mMh, monBar, monHi, "Mon H", monHiT, cMon, 1, monShow)
        farTxt += "Mon H " + str.tostring(monHi, format.mintick) + "  "
    if f_level(mMl, monBar, monLo, "Mon L", monLoT, cMon, 1, monShow)
        farTxt += "Mon L " + str.tostring(monLo, format.mintick) + "  "

// ───────────────────────────── WHEN: 1H / 4H zones ─────────────────────────────
type Zone
    box    bx
    float  top
    float  bot
    int    dir    // 1 bullish FVG, -1 bearish FVG, 0 BPR
    int    side   // 1 price was above the zone when created, -1 below
    string tf
    int    left   // time of the zone's first candle

var array<Zone> zones = array.new<Zone>()

f_tfLabel(simple string tf) =>
    s = timeframe.in_seconds(tf)
    s >= 86400 ? str.tostring(s / 86400) + "D" : s >= 3600 ? str.tostring(s / 3600) + "H" : str.tostring(s / 60) + "m"

lblA = f_tfLabel(tfA)
lblB = f_tfLabel(tfB)

f_zoneCol(int dir) =>
    dir == 1 ? cBull : dir == -1 ? cBear : cBpr

f_zoneTxt(int dir, string tfl) =>
    dir == 1 ? tfl + " buy zone (FVG)" : dir == -1 ? tfl + " sell zone (FVG)" : tfl + " BPR"

f_addZone(float top, float bot, int dir, int leftTime, string tfl) =>
    sd = close >= (top + bot) / 2 ? 1 : -1
    zones.unshift(Zone.new(na, top, bot, dir, sd, tfl, leftTime))
    if zones.size() > maxZones
        old = zones.pop()
        if not na(old.bx)
            old.bx.delete()
    true

f_newFvg(float top, float bot, int dir, int leftTime, string tfl) =>
    array<float> ots = array.new<float>()
    array<float> obs = array.new<float>()
    if showBpr
        for z in zones
            if z.dir == -dir and z.tf == tfl
                ot = math.min(top, z.top)
                ob = math.max(bot, z.bot)
                if ot > ob
                    ots.push(ot)
                    obs.push(ob)
    f_addZone(top, bot, dir, leftTime, tfl)
    if ots.size() > 0
        for k = 0 to ots.size() - 1
            f_addZone(ots.get(k), obs.get(k), 0, leftTime, tfl)
    true

// Values of the last CLOSED higher-timeframe candles (no repainting)
f_fvg() =>
    bull = low > high[2]
    bear = high < low[2]
    [time, bull[1], bear[1], low[1], high[3], low[3], high[1], time[3]]

[tA, bullA, bearA, c3LowA, c1HighA, c1LowA, c3HighA, leftA] = request.security(syminfo.tickerid, tfA, f_fvg(), lookahead = barmerge.lookahead_on)
[tB, bullB, bearB, c3LowB, c1HighB, c1LowB, c3HighB, leftB] = request.security(syminfo.tickerid, tfB, f_fvg(), lookahead = barmerge.lookahead_on)

okA = timeframe.in_seconds(tfA) > chartSec
okB = useB and tfB != tfA and timeframe.in_seconds(tfB) > chartSec
newA = ta.change(tA) != 0
newB = ta.change(tB) != 0

if okA and newA
    if bullA
        f_newFvg(c3LowA, c1HighA, 1, leftA, lblA)
    if bearA
        f_newFvg(c1LowA, c3HighA, -1, leftA, lblA)
if okB and newB
    if bullB
        f_newFvg(c3LowB, c1HighB, 1, leftB, lblB)
    if bearB
        f_newFvg(c1LowB, c3HighB, -1, leftB, lblB)

bool  inBullZone    = false
bool  inBearZone    = false
bool  bullZoneBelow = false
bool  bearZoneAbove = false
float tpShort = na   // nearest bullish gap / BPR below price: target for shorts
float tpLong  = na   // nearest bearish gap / BPR above price: target for longs
if zones.size() > 0
    for i = zones.size() - 1 to 0
        z = zones.get(i)
        isBullish = z.dir >= 0
        isBearish = z.dir <= 0
        if high >= z.bot and low <= z.top
            if isBullish
                inBullZone := true
            if isBearish
                inBearZone := true
        filled = z.side == 1 ? (fillMode == "Wick" ? low < z.bot : close < z.bot) : (fillMode == "Wick" ? high > z.top : close > z.top)
        if filled
            if not na(z.bx)
                z.bx.delete()
            zones.remove(i)
        else
            if isBullish and z.top < close
                bullZoneBelow := true
                tpShort := na(tpShort) ? z.top : math.max(tpShort, z.top)
            if isBearish and z.bot > close
                bearZoneAbove := true
                tpLong := na(tpLong) ? z.bot : math.min(tpLong, z.bot)

// Only show the nearest N zones above and below price
if barstate.islast and zones.size() > 0
    for z in zones
        zAbove = z.bot > close
        zBelow = z.top < close
        d = zAbove ? z.bot - close : zBelow ? close - z.top : 0.0
        int rank = 0
        for o in zones
            oAbove = o.bot > close
            oBelow = o.top < close
            od = oAbove ? o.bot - close : oBelow ? close - o.top : 0.0
            if oAbove == zAbove and oBelow == zBelow and od < d
                rank += 1
        typeOn = z.dir == 0 ? showBprZ : true
        tfOn = z.tf == lblA ? showFvgA : showFvgB
        vis = rank < nearN and typeOn and tfOn and f_near(zAbove ? z.bot : zBelow ? z.top : close)
        if vis and na(z.bx)
            col = f_zoneCol(z.dir)
            z.bx := box.new(z.left, z.top, time, z.bot, xloc = xloc.bar_time, extend = extend.right, bgcolor = col, border_color = col, text = f_zoneTxt(z.dir, z.tf), text_color = color.new(color.white, 10), text_size = szSmall, text_halign = text.align_left, text_valign = text.align_center)
        else if not vis and not na(z.bx)
            z.bx.delete()
            z.bx := na

// ───────────────────────────── Liquidity levels ─────────────────────────────
type Level
    float price
    int   bar
    float rsiAt
    bool  isEq = false
    line  ln

var array<Level> highs = array.new<Level>()
var array<Level> lows  = array.new<Level>()

f_drawLevel(Level lv, color c) =>
    if na(lv.ln) and lv.bar >= last_bar_index - lookback
        lv.ln := line.new(lv.bar, lv.price, bar_index, lv.price, color = color.new(c, lv.isEq ? 0 : 50), width = lv.isEq ? 2 : 1, style = lv.isEq ? line.style_solid : line.style_dotted)
    else if not na(lv.ln) and lv.isEq
        lv.ln.set_style(line.style_solid)
        lv.ln.set_width(2)
        lv.ln.set_color(c)
    true

f_taken(Level lv) =>
    if not na(lv.ln)
        if not showSwingL
            lv.ln.delete()
        else
            lv.ln.set_x2(bar_index)
            lv.ln.set_color(color.gray)
            lv.ln.set_style(line.style_dashed)
    true

// 1) Check which existing levels were taken on this bar
if highs.size() > 0
    for i = highs.size() - 1 to 0
        lv = highs.get(i)
        if high > lv.price
            bslTaken := true
            if lv.isEq
                bslEq := true
            else
                bslSwing := true
            if rsi < lv.rsiAt
                bearDiv := true    // price higher high, RSI lower high
            if i == 0 and close > lv.price
                bosUp := true
            f_taken(lv)
            highs.remove(i)
        else if not na(lv.ln)
            lv.ln.set_x2(bar_index)

if lows.size() > 0
    for i = lows.size() - 1 to 0
        lv = lows.get(i)
        if low < lv.price
            sslTaken := true
            if lv.isEq
                sslEq := true
            else
                sslSwing := true
            if rsi > lv.rsiAt
                bullDiv := true    // price lower low, RSI higher low
            if i == 0 and close < lv.price
                bosDn := true
            f_taken(lv)
            lows.remove(i)
        else if not na(lv.ln)
            lv.ln.set_x2(bar_index)

// 2) Add newly confirmed swings, flag equal highs / lows
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
tol = eqTol * atr

if not na(ph)
    pb = bar_index - pivLen
    nl = Level.new(ph, pb, rsi[pivLen])
    for o in highs
        if math.abs(o.price - ph) <= tol
            nl.isEq := true
            o.isEq := true
            if showEq or showSwingL
                f_drawLevel(o, cBsl)
    if showSwingL or (nl.isEq and showEq)
        f_drawLevel(nl, cBsl)
    if nl.isEq and draw and showEq
        label.new(pb, ph, "EQH", style = label.style_label_down, color = noColor, textcolor = cBsl, size = szSmall, tooltip = "Equal highs: stops rest just above. Buy-side liquidity.")
    highs.unshift(nl)
    if highs.size() > maxLevels
        old = highs.pop()
        if not na(old.ln)
            old.ln.delete()

if not na(pl)
    pb = bar_index - pivLen
    nl = Level.new(pl, pb, rsi[pivLen])
    for o in lows
        if math.abs(o.price - pl) <= tol
            nl.isEq := true
            o.isEq := true
            if showEq or showSwingL
                f_drawLevel(o, cSsl)
    if showSwingL or (nl.isEq and showEq)
        f_drawLevel(nl, cSsl)
    if nl.isEq and draw and showEq
        label.new(pb, pl, "EQL", style = label.style_label_up, color = noColor, textcolor = cSsl, size = szSmall, tooltip = "Equal lows: stops rest just below. Sell-side liquidity.")
    lows.unshift(nl)
    if lows.size() > maxLevels
        old = lows.pop()
        if not na(old.ln)
            old.ln.delete()

f_syncFar(array<Level> lvls) =>
    for lv in lvls
        if not na(lv.ln) and not f_near(lv.price)
            lv.ln.delete()
            lv.ln := na
    true

if barstate.islast and keepScale
    f_syncFar(highs)
    f_syncFar(lows)

// 3) Sweep and inducement markers. Text only for key pools. Hover a marker for full detail.
// A BOS toward a NEARBY zone that price has not reached yet = early traders = possible inducement (IDM?)
var int lastIdmUp = -100000
var int lastIdmDn = -100000
idmUp = bosUp and bullZoneBelow and not na(tpShort) and close - tpShort <= idmAtr * atr and bar_index - lastIdmUp > idmGap
idmDn = bosDn and bearZoneAbove and not na(tpLong) and tpLong - close <= idmAtr * atr and bar_index - lastIdmDn > idmGap
if idmUp
    lastIdmUp := bar_index
if idmDn
    lastIdmDn := bar_index
keyB = bslHtf != "" or bslEq
keyS = sslHtf != "" or sslEq

f_pools(string htf, bool eq, bool swing, string eqName, string swName) =>
    htf + (eq ? eqName + " " : "") + (swing and not eq and htf == "" ? swName : "")

f_tip(string side, string pools, bool div, bool inZ, string zName) =>
    side + " liquidity taken: " + (pools == "" ? "none" : pools) + "\nRSI divergence: " + (div ? "yes" : "no") + "\nInside a " + zName + " 1H/4H zone: " + (inZ ? "yes" : "no")

var string lastBslName = ""
var string lastSslName = ""
if bslTaken
    lastBslName := f_pools(bslHtf, bslEq, bslSwing, "EQH", "swing high ")
if sslTaken
    lastSslName := f_pools(sslHtf, sslEq, sslSwing, "EQL", "swing low ")

allSweeps  = sweepScope == "All"
zoneSweeps = sweepScope != "Key pools only"
if draw
    if showSweeps and bslTaken and (keyB or (zoneSweeps and inBearZone) or allSweeps)
        pools = f_pools(bslHtf, bslEq, bslSwing, "EQH", "swing H")
        txt = keyB or allSweeps ? pools + (bearDiv and showDivCol ? " div" : "") : ""
        mc = bearDiv and showDivCol ? color.yellow : cBsl
        label.new(bar_index, high, txt, yloc = yloc.abovebar, style = label.style_triangledown, color = mc, textcolor = mc, size = size.tiny, tooltip = f_tip("Buy-side", pools, bearDiv, inBearZone, "bearish"))
    if showSweeps and sslTaken and (keyS or (zoneSweeps and inBullZone) or allSweeps)
        pools = f_pools(sslHtf, sslEq, sslSwing, "EQL", "swing L")
        txt = keyS or allSweeps ? pools + (bullDiv and showDivCol ? " div" : "") : ""
        mc = bullDiv and showDivCol ? color.yellow : cSsl
        label.new(bar_index, low, txt, yloc = yloc.belowbar, style = label.style_triangleup, color = mc, textcolor = mc, size = size.tiny, tooltip = f_tip("Sell-side", pools, bullDiv, inBullZone, "bullish"))
    if showIdm and idmUp
        label.new(bar_index, low, "IDM?", yloc = yloc.belowbar, style = label.style_diamond, color = cIdm, textcolor = cIdm, size = size.tiny, tooltip = "Possible inducement: bullish BOS before price reached the bullish 1H/4H zone just below.\nEarly buyers may be trapped. Their stops below are fuel for a sweep into the zone.")
    if showIdm and idmDn
        label.new(bar_index, high, "IDM?", yloc = yloc.abovebar, style = label.style_diamond, color = cIdm, textcolor = cIdm, size = size.tiny, tooltip = "Possible inducement: bearish BOS before price reached the bearish 1H/4H zone just above.\nEarly sellers may be trapped. Their stops above are fuel for a sweep into the zone.")
    if showBos and bosUp and not (showIdm and idmUp)
        label.new(bar_index, high, "BOS", style = label.style_label_down, color = noColor, textcolor = color.gray, size = szSmall)
    if showBos and bosDn and not (showIdm and idmDn)
        label.new(bar_index, low, "BOS", style = label.style_label_up, color = noColor, textcolor = color.gray, size = szSmall)

// ───────────────────────────── NOW: displacement, setups, entries ─────────────────────────────
// Candle 1 = bar[2], candle 2 = bar[1] (big body), candle 3 = current bar (same direction, leaves FVG)
big1     = math.abs(close[1] - open[1]) >= dispMult * atr[1]
bullDisp = big1 and close[1] > open[1] and close > open and low > high[2]
bearDisp = big1 and close[1] < open[1] and close < open and high < low[2]

sinceBsl      = nz(ta.barssince(bslTaken), 100000)
sinceSsl      = nz(ta.barssince(sslTaken), 100000)
sinceBearZ    = nz(ta.barssince(inBearZone), 100000)
sinceBullZ    = nz(ta.barssince(inBullZone), 100000)
sinceBearDiv  = nz(ta.barssince(bearDiv), 100000)
sinceBullDiv  = nz(ta.barssince(bullDiv), 100000)
sinceBearDisp = nz(ta.barssince(bearDisp), 100000)
sinceBullDisp = nz(ta.barssince(bullDisp), 100000)
hiWin = ta.highest(high, window + 2)
loWin = ta.lowest(low, window + 2)

// Order block = last opposite-colour candle before the displacement candle
f_obHigh() =>
    float r = na
    for i = 2 to 20
        if close[i] > open[i]
            r := high[i]
            break
    r

f_obLow() =>
    float r = na
    for i = 2 to 20
        if close[i] < open[i]
            r := low[i]
            break
    r

var int lastShort = -100000
var int lastLong  = -100000

shortSetup = bearDisp and allowShort and not monBlock and sinceBsl <= window and (not reqZone or sinceBearZ <= window) and (not reqDiv or sinceBearDiv <= window) and bar_index - lastShort > window
longSetup  = bullDisp and allowLong and not monBlock and sinceSsl <= window and (not reqZone or sinceBullZ <= window) and (not reqDiv or sinceBullDiv <= window) and bar_index - lastLong > window

var float sTop = na
var float sBot = na
var float sSl  = na
var float sTp  = na
var int   sExp = na
var float lTop = na
var float lBot = na
var float lSl  = na
var float lTp  = na
var int   lExp = na

obH = f_obHigh()
obL = f_obLow()

f_px(float v) =>
    str.tostring(v, format.mintick)

if shortSetup
    lastShort := bar_index
    sTop := low[2]
    sBot := high
    sSl  := math.max(na(obH) ? hiWin : obH, sTop) + slBuf * atr
    sTp  := tpShort
    sExp := bar_index + entryExp
    if draw and showSetups
        box.new(bar_index - 2, sTop, bar_index + entryExp, sBot, bgcolor = color.new(color.red, 70), border_color = color.red, text = "entry", text_color = color.white, text_size = size.tiny)
        label.new(bar_index, high, "SHORT setup", style = label.style_label_down, color = color.new(color.red, 30), textcolor = color.white, size = szSmall, tooltip = "Liquidity taken + bearish 1H/4H zone + displacement" + (sinceBearDiv <= window ? " + RSI divergence" : "") + "\nWait for price to retrace into the entry zone.\nSL " + f_px(sSl) + (na(sTp) ? "" : "\nTP " + f_px(sTp)))

if longSetup
    lastLong := bar_index
    lTop := low
    lBot := high[2]
    lSl  := math.min(na(obL) ? loWin : obL, lBot) - slBuf * atr
    lTp  := tpLong
    lExp := bar_index + entryExp
    if draw and showSetups
        box.new(bar_index - 2, lTop, bar_index + entryExp, lBot, bgcolor = color.new(color.teal, 70), border_color = color.teal, text = "entry", text_color = color.white, text_size = size.tiny)
        label.new(bar_index, low, "LONG setup", style = label.style_label_up, color = color.new(color.teal, 30), textcolor = color.white, size = szSmall, tooltip = "Liquidity taken + bullish 1H/4H zone + displacement" + (sinceBullDiv <= window ? " + RSI divergence" : "") + "\nWait for price to retrace into the entry zone.\nSL " + f_px(lSl) + (na(lTp) ? "" : "\nTP " + f_px(lTp)))

// Conservative entry: retrace into the entry FVG, then a candle that engulfs the previous body
bool shortEntry = false
bool longEntry  = false

// Position-tool style boxes: red = risk (entry to SL), green = reward (entry to TP)
f_tradeBoxes(float entry, float sl, float tp) =>
    box.new(bar_index, math.max(entry, sl), bar_index + 15, math.min(entry, sl), bgcolor = color.new(color.red, 75), border_color = color.new(color.red, 40), text = "SL " + f_px(sl), text_color = color.white, text_size = szSmall, text_valign = sl > entry ? text.align_top : text.align_bottom)
    if not na(tp)
        rr = math.abs(tp - entry) / math.max(math.abs(entry - sl), syminfo.mintick)
        box.new(bar_index, math.max(entry, tp), bar_index + 15, math.min(entry, tp), bgcolor = color.new(color.green, 75), border_color = color.new(color.green, 40), text = "TP " + f_px(tp) + "  (1:" + str.tostring(rr, "#.#") + ")", text_color = color.white, text_size = szSmall, text_valign = tp > entry ? text.align_top : text.align_bottom)
    true

if not na(sExp) and bar_index > lastShort
    if high > sSl or bar_index > sExp
        sExp := na
    else if high >= sBot and close < open and close < math.min(open[1], close[1]) and close < sTop
        shortEntry := true
        sExp := na
        if draw and showTrades
            label.new(bar_index, high, "SELL", style = label.style_label_down, color = color.red, textcolor = color.white, size = szSmall)
            f_tradeBoxes(close, sSl, sTp)

if not na(lExp) and bar_index > lastLong
    if low < lSl or bar_index > lExp
        lExp := na
    else if low <= lTop and close > open and close > math.max(open[1], close[1]) and close > lBot
        longEntry := true
        lExp := na
        if draw and showTrades
            label.new(bar_index, low, "BUY", style = label.style_label_up, color = color.teal, textcolor = color.white, size = szSmall)
            f_tradeBoxes(close, lSl, lTp)

// ───────────────────────────── Status panel (plain words) + legend ─────────────────────────────
tPos = tablePosI == "Bottom right" ? position.bottom_right : tablePosI == "Top left" ? position.top_left : tablePosI == "Bottom left" ? position.bottom_left : position.top_right
lPos = tablePosI == "Bottom right" ? position.top_right : position.bottom_right
var table tb  = table.new(tPos, 3, 10, bgcolor = color.new(#131722, 5), border_color = color.new(color.gray, 70), border_width = 1, frame_color = color.gray, frame_width = 1)
var table lgd = table.new(lPos, 2, 8, bgcolor = color.new(#131722, 5), frame_color = color.gray, frame_width = 1)

f_cell(int c, int r, string t, color bg, color fg) =>
    table.cell(tb, c, r, t, text_color = fg, text_size = sz, bgcolor = bg, text_halign = c == 0 ? text.align_left : text.align_center)

f_step(int c, int r, bool ok, string t) =>
    f_cell(c, r, t, ok ? color.new(color.green, 45) : na, ok ? color.white : color.gray)

f_ago(int n) =>
    n == 0 ? "now" : str.tostring(n) + " bars ago"

f_next(bool dirOk, bool pend, bool z, bool liq, bool disp, string zoneWord, string liqWord, string dispWord) =>
    not dirOk ? "Direction off" : monBlock ? "Monday: no trades" : pend ? "Wait: retrace into entry box" : not z ? "Wait: price to reach " + zoneWord : not liq ? "Wait: " + liqWord + " sweep" : not disp ? "Wait: " + dispWord + " displacement" : "Check chart: setup forming"

if showTable and barstate.islast
    hdr = color.new(#2a2e39, 0)
    wht = color.white
    s1 = allowShort and not monBlock
    l1 = allowLong and not monBlock
    s2 = sinceBearZ <= window
    l2 = sinceBullZ <= window
    s3 = sinceBsl <= window
    l3 = sinceSsl <= window
    s4 = sinceBearDiv <= window
    l4 = sinceBullDiv <= window
    s5 = sinceBearDisp <= window
    l5 = sinceBullDisp <= window
    f_cell(0, 0, "LQ Playbook", hdr, wht)
    f_cell(1, 0, "SHORT", hdr, color.red)
    f_cell(2, 0, "LONG", hdr, color.teal)
    f_cell(0, 1, "Where: direction", na, wht)
    f_step(1, 1, s1, not allowShort ? "off" : monBlock ? "Monday" : "allowed")
    f_step(2, 1, l1, not allowLong ? "off" : monBlock ? "Monday" : "allowed")
    f_cell(0, 2, "1. 1H/4H zone", na, wht)
    f_step(1, 2, s2, s2 ? "in sell zone" : na(tpLong) ? "none above" : "above at " + f_px(tpLong))
    f_step(2, 2, l2, l2 ? "in buy zone" : na(tpShort) ? "none below" : "below at " + f_px(tpShort))
    f_cell(0, 3, "3. Liquidity taken", na, wht)
    f_step(1, 3, s3, s3 ? lastBslName + "· " + f_ago(sinceBsl) : "not yet")
    f_step(2, 3, l3, l3 ? lastSslName + "· " + f_ago(sinceSsl) : "not yet")
    f_cell(0, 4, "3. RSI divergence", na, wht)
    f_step(1, 4, s4, s4 ? "yes" : "no")
    f_step(2, 4, l4, l4 ? "yes" : "no")
    f_cell(0, 5, "4. Displacement", na, wht)
    f_step(1, 5, s5, s5 ? "yes · " + f_ago(sinceBearDisp) : "not yet")
    f_step(2, 5, l5, l5 ? "yes · " + f_ago(sinceBullDisp) : "not yet")
    f_cell(0, 6, "6. Target (1H/4H)", na, wht)
    f_cell(1, 6, na(tpShort) ? "none" : f_px(tpShort), na, wht)
    f_cell(2, 6, na(tpLong) ? "none" : f_px(tpLong), na, wht)
    f_cell(0, 7, "NEXT", hdr, color.yellow)
    f_cell(1, 7, f_next(allowShort, not na(sExp), s2, s3, s5, "sell zone", "buy-side", "bearish"), hdr, color.yellow)
    f_cell(2, 7, f_next(allowLong, not na(lExp), l2, l3, l5, "buy zone", "sell-side", "bullish"), hdr, color.yellow)
    if farTxt != ""
        f_cell(0, 8, "Not drawn (too far)", na, color.gray)
        f_cell(1, 8, farTxt, na, color.gray)
        f_cell(2, 8, "", na, wht)
    if isAuto
        f_cell(0, 9, "Auto daily bias", na, wht)
        f_cell(1, 9, dBias == 1 ? "Bullish" : dBias == -1 ? "Bearish" : "None", na, wht)
        f_cell(2, 9, "", na, wht)

f_lg(int r, string sym, color c, string t) =>
    table.cell(lgd, 0, r, sym, text_color = c, text_size = sz)
    table.cell(lgd, 1, r, t, text_color = color.white, text_size = szSmall, text_halign = text.align_left)

if showLegend and barstate.islast
    f_lg(0, "■", color.new(color.red, 20), "Sell zone: bearish 1H/4H FVG")
    f_lg(1, "■", color.new(color.teal, 20), "Buy zone: bullish 1H/4H FVG")
    f_lg(2, "■", color.new(color.purple, 20), "BPR: both FVGs overlap")
    f_lg(3, "━", cBsl, "PDH / PWH: buy-side liquidity")
    f_lg(4, "━", cSsl, "PDL / PWL: sell-side liquidity")
    f_lg(5, "▼ ▲", cBsl, "Liquidity taken (orange above / aqua below)")
    f_lg(6, "▼ ▲", color.yellow, "Taken with RSI divergence")
    f_lg(7, "◆", cIdm, "Possible inducement: early traders")

var table warnTb = table.new(position.bottom_center, 1, 1)
if barstate.islast and chartSec >= 3600
    table.cell(warnTb, 0, 0, "LQ Playbook is built for 5m to 15m charts. On this timeframe the 1H/4H zones are off and most bars take a swing.", text_color = color.black, text_size = sz, bgcolor = color.new(color.orange, 15))

// ───────────────────────────── Alerts ─────────────────────────────
alertcondition(inBearZone and not inBearZone[1], "Step 1: price reached bearish 1H/4H zone", "LQ Playbook: price entered a bearish 1H/4H FVG/BPR on {{ticker}}")
alertcondition(inBullZone and not inBullZone[1], "Step 1: price reached bullish 1H/4H zone", "LQ Playbook: price entered a bullish 1H/4H FVG/BPR on {{ticker}}")
alertcondition(bslTaken and inBearZone, "Step 3: buy-side liquidity taken inside bearish zone", "LQ Playbook: buy-side liquidity swept inside a bearish zone on {{ticker}}")
alertcondition(sslTaken and inBullZone, "Step 3: sell-side liquidity taken inside bullish zone", "LQ Playbook: sell-side liquidity swept inside a bullish zone on {{ticker}}")
alertcondition(shortSetup, "Step 4: short setup", "LQ Playbook: short setup on {{ticker}} (liquidity taken + zone + displacement)")
alertcondition(longSetup, "Step 4: long setup", "LQ Playbook: long setup on {{ticker}} (liquidity taken + zone + displacement)")
alertcondition(shortEntry, "Step 5: short entry", "LQ Playbook: SELL trigger on {{ticker}}")
alertcondition(longEntry, "Step 5: long entry", "LQ Playbook: BUY trigger on {{ticker}}")
